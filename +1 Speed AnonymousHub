	local function readNumber(instance, names)
		if not instance then
			return nil
		end

		for attributeName, attributeValue in pairs(instance:GetAttributes()) do
			local key = normalize(attributeName)

			for _, wanted in ipairs(names) do
				if key == wanted or string.find(key, wanted, 1, true) then
					local number = tonumber(attributeValue)
					if number then
						return number
					end
				end
			end
		end

		for _, descendant in ipairs(instance:GetDescendants()) do
			local key = normalize(descendant.Name)

			for _, wanted in ipairs(names) do
				if key == wanted or string.find(key, wanted, 1, true) then
					if descendant:IsA("IntValue") or descendant:IsA("NumberValue") then
						return tonumber(descendant.Value)
					elseif descendant:IsA("StringValue") then
						local number = tonumber(descendant.Value)
						if number then
							return number
						end
					end
				end
			end
		end

		return nil
	end

	local function getTexts(instance)
		local texts = {instance and instance.Name or ""}

		if not instance then
			return texts
		end

		for _, descendant in ipairs(instance:GetDescendants()) do
			if descendant:IsA("TextLabel")
				or descendant:IsA("TextButton")
				or descendant:IsA("TextBox") then

				table.insert(texts, descendant.Text)
			elseif descendant:IsA("StringValue") then
				table.insert(texts, descendant.Value)
			end
		end

		return texts
	end

	local function readNamedNumber(instance, wantedNames)
		return readNumber(instance, wantedNames)
	end

	local function readTextNumber(instance, patterns)
		for _, textValue in ipairs(getTexts(instance)) do
			for _, pattern in ipairs(patterns) do
				local found = string.match(string.lower(tostring(textValue)), pattern)

				if found then
					return tonumber(found)
				end
			end
		end

		return nil
	end

	local function getTreadmillPart(instance)
		if not instance then
			return nil
		end

		if instance:IsA("BasePart") then
			return instance
		end

		if instance:IsA("Model")
			and instance.PrimaryPart
			and instance.PrimaryPart:IsA("BasePart") then

			return instance.PrimaryPart
		end

		for _, preferred in ipairs({
			"Belt",
			"Platform",
			"MainPart",
			"Base",
			"Hitbox",
			"Treadmill"
		}) do
			local part = instance:FindFirstChild(preferred, true)
			if part and part:IsA("BasePart") then
				return part
			end
		end

		local bestPart = nil
		local bestArea = 0

		for _, descendant in ipairs(instance:GetDescendants()) do
			if descendant:IsA("BasePart") then
				local area = descendant.Size.X * descendant.Size.Z

				if area > bestArea then
					bestArea = area
					bestPart = descendant
				end
			end
		end

		return bestPart
	end

	local function isPaidTreadmill(instance)
		if not instance then
			return false
		end

		local paidKeys = {
			"robux",
			"gamepass",
			"product",
			"developerproduct",
			"premium",
			"paid",
			"purchase"
		}

		local combinedText = string.lower(instance.Name)

		for attributeName, attributeValue in pairs(instance:GetAttributes()) do
			local key = normalize(attributeName)
			local valueText = string.lower(tostring(attributeValue))

			for _, paidKey in ipairs(paidKeys) do
				if string.find(key, paidKey, 1, true)
					or string.find(valueText, paidKey, 1, true) then

					return true
				end
			end

			if (
				key == "isrobux"
				or key == "isgamepass"
				or key == "ispaid"
				or key == "requirespurchase"
			) and attributeValue == true then

				return true
			end
		end

		for _, value in ipairs(getTexts(instance)) do
			combinedText ..= " " .. string.lower(value)
		end

		for _, paidKey in ipairs(paidKeys) do
			if string.find(combinedText, paidKey, 1, true) then
				return true
			end
		end

		if readNamedNumber(instance, {
			"gamepassid",
			"productid",
			"developerproductid",
			"robuxprice"
		}) then
			return true
		end

		return false
	end

	local function getTreadmillInfo(instance)
		local requirement =
			readNamedNumber(instance, {
				"rebirthsrequired",
				"requiredrebirths",
				"rebirthrequirement",
				"rebirths",
				"rebirth"
			})
			or readTextNumber(instance, {
				"(%d+)%s*rebirth",
				"rebirth[%a%s:_%-]*(%d+)"
			})
			or 0

		local multiplier =
			readNamedNumber(instance, {
				"speedmultiplier",
				"treadmillmultiplier",
				"multiplier",
				"boost"
			})
			or readTextNumber(instance, {
				"[xX]%s*(%d+%.?%d*)",
				"(%d+%.?%d*)%s*[xX]"
			})
			or tonumber(string.match(string.lower(instance.Name), "[xX]%s*(%d+%.?%d*)"))
			or tonumber(string.match(string.lower(instance.Name), "(%d+%.?%d*)%s*[xX]"))
			or 1

		return {
			Instance = instance,
			Part = getTreadmillPart(instance),
			Requirement = math.max(0, tonumber(requirement) or 0),
			Multiplier = math.max(1, tonumber(multiplier) or 1),
			Paid = isPaidTreadmill(instance)
		}
	end

	local function getBestTreadmill()
		local folder = workspace:FindFirstChild("Treadmills")
			or workspace:FindFirstChild("Treadmills", true)

		if not folder then
			return nil
		end

		local rebirths = getRebirths()
		local candidates = {}

		local paidMultipliers = {
			[5] = true,
			[27] = true,
			[100] = true
		}

		local function addCandidate(instance)
			if not (
				instance:IsA("Model")
				or instance:IsA("BasePart")
			) then
				return
			end

			local info = getTreadmillInfo(instance)

			if not info.Part then
				return
			end

			local knownRequirementByMultiplier = {
				[1] = 0,
				[3] = 2,
				[9] = 5,
				[50] = 15
			}

			if paidMultipliers[info.Multiplier] then
				info.Paid = true
			end

			if knownRequirementByMultiplier[info.Multiplier] ~= nil then
				info.Requirement =
					knownRequirementByMultiplier[info.Multiplier]
			end

			local lowerName = string.lower(instance.Name)

			if string.find(lowerName, "robux", 1, true)
				or string.find(lowerName, "gamepass", 1, true)
				or string.find(lowerName, "paid", 1, true) then

				info.Paid = true
			end

			if not info.Paid then
				table.insert(candidates, info)
			end
		end

		for _, child in ipairs(folder:GetChildren()) do
			addCandidate(child)
		end

		if #candidates == 0 then
			for _, descendant in ipairs(folder:GetDescendants()) do
				if descendant:IsA("Model") then
					addCandidate(descendant)
				end
			end
		end

		local best = nil

		for _, info in ipairs(candidates) do
			if info.Requirement <= rebirths then
				if not best
					or info.Requirement > best.Requirement
					or (
						info.Requirement == best.Requirement
						and info.Multiplier > best.Multiplier
					) then

					best = info
				end
			end
		end

		if rebirths <= 0 then
			local initial = nil

			for _, info in ipairs(candidates) do
				if info.Requirement == 0
					and info.Multiplier == 1 then

					initial = info
					break
				end
			end

			if initial then
				best = initial
			end
		end

		return best
	end

	local function getTreadmillCFrame(info)
		if not info or not info.Part or not info.Part:IsDescendantOf(workspace) then
			return nil
		end

		local root = getRoot()
		local humanoid = getHumanoid()

		if not root or not humanoid then
			return nil
		end

		local part = info.Part
		local y =
			part.Position.Y
			+ (part.Size.Y / 2)
			+ humanoid.HipHeight
			+ (root.Size.Y / 2)
			+ 0.1

		local position = Vector3.new(part.Position.X, y, part.Position.Z)
		local look = part.CFrame.LookVector

		return CFrame.lookAt(position, position + look)
	end

	local function stopFarmAnimation()
