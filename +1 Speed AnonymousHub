	local function getVisibleContentBottom(page)
		local bottom = 0

		for _, child in ipairs(page:GetChildren()) do
			if child:IsA("GuiObject") and child.Visible then
				local y = child.Position.Y.Offset
				local height = child.Size.Y.Offset
				bottom = math.max(bottom, y + height)
			end
		end

		return bottom
	end

	local function updateWindowHeight()
		if minimized or closed then
			return
		end

		local page = getCurrentPage()
		local contentBottom = getVisibleContentBottom(page)

		local desiredHeight =
			TOP_CONTENT_OFFSET
			+ contentBottom
			+ BOTTOM_PADDING

		desiredHeight = math.clamp(
			desiredHeight,
			MIN_WINDOW_HEIGHT,
			MAX_WINDOW_HEIGHT
		)

		frame.Size = UDim2.fromOffset(WINDOW_WIDTH, desiredHeight)
		content.Size = UDim2.new(
