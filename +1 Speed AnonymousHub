	local function getDamageOrbs()
		local list = {}
		local seen = {}

		for _, descendant in ipairs(workspace:GetDescendants()) do
			if (
				descendant:IsA("Model")
				or descendant:IsA("BasePart")
			) and isDamageOrbName(descendant.Name) then

				local part = getOrbPart(descendant)

				if part and not seen[part] then
					seen[part] = true

					table.insert(list, {
						Instance = descendant,
						Part = part
					})
				end
			end
		end

		return list
	end

	local function teleportNearestOrb()
		local root = getRoot()

		if not root then
			return false
		end

		local nearest = nil
		local nearestDistance = math.huge

		for _, orb in ipairs(getDamageOrbs()) do
			local distance = (root.Position - orb.Part.Position).Magnitude

			if distance < nearestDistance then
				nearestDistance = distance
				nearest = orb
			end
		end

		if not nearest then
			return false
		end

		local success = teleportToCFrame(
			CFrame.new(nearest.Part.Position) * root.CFrame.Rotation
		)

		if success then
			lastLocalOrbTouchTime = os.clock()
		end

		return success
	end

	local function teleportNextOrb()
		local orbs = getDamageOrbs()

		if #orbs == 0 then
			bossOrbIndex = 0
			return false
		end

		bossOrbIndex += 1

		if bossOrbIndex > #orbs then
			bossOrbIndex = 1
		end

		local root = getRoot()

		if not root then
			return false
		end

		local success = teleportToCFrame(
			CFrame.new(orbs[bossOrbIndex].Part.Position)
				* root.CFrame.Rotation
		)

		if success then
			lastLocalOrbTouchTime = os.clock()
		end

		return success
	end

	local function getBossRemote()
		local modules = ReplicatedStorage:FindFirstChild("Modules")
		local shared = modules and modules:FindFirstChild("Shared")
		local serviceScript = shared and shared:FindFirstChild("RemoteEventService")

		if not serviceScript then
			return nil
		end

		local direct = serviceScript:FindFirstChild("BossFightRemoteEvent")

		if direct and direct:IsA("RemoteEvent") then
			return direct
		end

		local success, service = pcall(require, serviceScript)

		if success and type(service) == "table" and type(service.Get) == "function" then
			local ok, remote = pcall(service.Get, "BossFight")

			if not ok then
				ok, remote = pcall(service.Get, service, "BossFight")
			end

			if ok and remote and remote:IsA("RemoteEvent") then
				return remote
			end
		end

		return nil
	end

	local bossRemoteConnection = nil

	local function connectBossRemote()
		if bossRemoteConnection then
			bossRemoteConnection:Disconnect()
			bossRemoteConnection = nil
		end

		local remote = getBossRemote()

		if not remote then
			return
		end

		bossRemoteConnection = remote.OnClientEvent:Connect(function(eventName, ...)
			if eventName == "CutsceneEnd"
				or eventName == "MiniBossFightStart" then

				local maxHealth = tonumber((...)) or 0

				bossReady = true
				bossRemoteKnown = true
				bossMaxHealth = maxHealth
				bossCurrentHealth = maxHealth
				bossLastHealth = maxHealth
				bossMyDamage = 0
				bossOthersDamage = 0
				lastLocalOrbTouchTime = -math.huge

			elseif eventName == "UpdateHealth" then
				local currentHealth, maxHealth = ...

				currentHealth = tonumber(currentHealth) or 0
				maxHealth = tonumber(maxHealth) or bossMaxHealth

				if bossLastHealth and currentHealth < bossLastHealth then
					local damageDelta = bossLastHealth - currentHealth

					if os.clock() - lastLocalOrbTouchTime <= MY_DAMAGE_WINDOW then
						bossMyDamage += damageDelta
					else
						bossOthersDamage += damageDelta
					end
				end

				bossCurrentHealth = currentHealth
				bossMaxHealth = maxHealth
				bossLastHealth = currentHealth
				bossReady = currentHealth > 0
				bossRemoteKnown = true

			elseif eventName == "BossFightEnd"
				or eventName == "DeathCutscene"
				or eventName == "GateCloseCutscene"
				or eventName == "DoorCutsceneStart"
				or eventName == "StartCutscene" then

				bossReady = false
				bossRemoteKnown = true
			end
		end)
	end

	local function isBossReady()
		if bossRemoteKnown then
			return bossReady
		end

		return #getDamageOrbs() > 0
	end

