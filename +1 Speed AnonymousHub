	local function playFarmAnimation()
		stopFarmAnimation()

		local humanoid = getHumanoid()

		if not humanoid then
			return false
		end

		local animator = humanoid:FindFirstChildOfClass("Animator")

		if not animator then
			animator = Instance.new("Animator")
			animator.Parent = humanoid
		end

		local animation = Instance.new("Animation")
		animation.AnimationId =
			humanoid.RigType == Enum.HumanoidRigType.R6
			and "rbxassetid://180426354"
			or "rbxassetid://507777826"

		local success, track = pcall(function()
			return animator:LoadAnimation(animation)
		end)

		animation:Destroy()

		if not success or not track then
			return false
		end

		track.Priority = Enum.AnimationPriority.Action
		track.Looped = true
		track:Play(0.15, 1, FARM_ANIMATION_SPEED)
		track:AdjustSpeed(FARM_ANIMATION_SPEED)

		farmAnimationTrack = track
		return true
	end

	local function stopFarm()
		farmActive = false
		farmSelected = nil
		farmAnchorCFrame = nil

		if farmConnection then
			farmConnection:Disconnect()
			farmConnection = nil
		end

		stopFarmAnimation()

		local humanoid = player.Character
			and player.Character:FindFirstChildOfClass("Humanoid")

		if humanoid then
			humanoid.AutoRotate = true
		end
	end

	local function startBestFarm()
		local best = getBestTreadmill()

		if not best then
			return false
		end

		local target = getTreadmillCFrame(best)

		if not target then
			return false
		end

		stopFarm()

		local humanoid = getHumanoid()

		if not humanoid then
			return false
		end

		farmActive = true
		farmSelected = best
		farmAnchorCFrame = target
		humanoid.AutoRotate = false

		teleportToCFrame(target)
		playFarmAnimation()

		farmConnection = RunService.Heartbeat:Connect(function()
			if not farmActive or not farmAnchorCFrame then
				return
			end

			local root = getRoot()
			local currentHumanoid = getHumanoid()

			if not root or not currentHumanoid or currentHumanoid.Health <= 0 then
				return
			end

			if (root.Position - farmAnchorCFrame.Position).Magnitude
				> FARM_POSITION_TOLERANCE then

				root.CFrame = farmAnchorCFrame
			end

			pcall(function()
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
			end)
		end)

		return true
	end

