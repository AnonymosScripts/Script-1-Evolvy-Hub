local function lerpColor(a, b, alpha)
	return Color3.new(
		a.R + (b.R - a.R) * alpha,
		a.G + (b.G - a.G) * alpha,
		a.B + (b.B - a.B) * alpha
	)
end

local function getAnimatedRoleColor(role)
	local base = CONFIG.ROLE_COLORS[role] or CONFIG.ROLE_COLORS.Unknown

	if role ~= "Murderer" and role ~= "Sheriff" and role ~= "Hero" then
		return base
	end

	local phase = (math.sin(state.roleColorTime * 2.6) + 1) * 0.5

	local lighter
	local darker

	if role == "Murderer" then
		lighter = Color3.fromRGB(255, 115, 115)
		darker = Color3.fromRGB(175, 20, 20)
	elseif role == "Sheriff" then
		lighter = Color3.fromRGB(115, 175, 255)
		darker = Color3.fromRGB(25, 75, 190)
	else
		lighter = Color3.fromRGB(255, 240, 110)
		darker = Color3.fromRGB(190, 130, 10)
	end

	local tonal = lerpColor(darker, lighter, phase)
	return lerpColor(base, tonal, 0.68)
end

local function updateNameTag(player, role)
	if player == LocalPlayer then
		return
	end

	if not state.espEnabled or not player.Character then
		destroyNameTag(player)
		return
	end

	local _, _, targetRoot = getCharacterData(player)

	if not targetRoot then
		destroyNameTag(player)
		return
	end

	local distance = (getViewerPosition() - targetRoot.Position).Magnitude

	if distance > 180 then
		destroyNameTag(player)
		return
	end

	local billboard = getNameTag(player)

	if not billboard then
		return
	end

	local holder = billboard:FindFirstChild("Holder")
	local roleLabel = holder and holder:FindFirstChild("Role")
	local nameLabel = holder and holder:FindFirstChild("PlayerName")
	local color = getAnimatedRoleColor(role)

	if roleLabel then
		roleLabel.Text = getRoleDisplay(role)
		roleLabel.TextColor3 = color
	end

	if nameLabel then
		nameLabel.TextColor3 = color
		nameLabel.Text = string.format(
			"%s  [%dM]",
			player.DisplayName,
			math.floor(distance + 0.5)
		)
	end

end

local function updateESP(player)
	if player == LocalPlayer then
		return
	end

	if not state.espEnabled then
		destroyHighlight(player)
		destroyNameTag(player)
		return
	end

	if not player.Character then
		destroyHighlight(player)
		destroyNameTag(player)
		return
	end

	local _, _, targetRoot = getCharacterData(player)

	if not targetRoot then
		destroyHighlight(player)
		destroyNameTag(player)
		return
	end

	local distance = (getViewerPosition() - targetRoot.Position).Magnitude

	if distance > 180 then
		destroyHighlight(player)
		destroyNameTag(player)
		return
	end

	local role, source = detectRole(player)
	updateNameTag(player, role)
	local highlight = getHighlight(player)

	if not highlight then
		return
	end

	local color = CONFIG.ROLE_COLORS[role] or CONFIG.ROLE_COLORS.Unknown

	highlight.FillColor = color
	highlight.OutlineColor = color

	if state.lastRoles[player] ~= role then
		state.lastRoles[player] = role
		log(player.Name, "=>", role, "|", source)
	end
end

local function getObjectPosition(object)
	if object:IsA("BasePart") then
		return object.Position
	end

	if object:IsA("Model") then
		local success, pivot = pcall(function()
			return object:GetPivot()
		end)

		if success then
			return pivot.Position
		end
	end

	return nil
end

local function isAvailableCoin(coin)
	if not coin or not coin.Parent then
		return false
	end

	if coin:GetAttribute("Delete") == true then
		return false
	end

	if coin:GetAttribute("Collected") == true then
		return false
	end

	if coin:GetAttribute("RoundEnd") == true then
		return false
	end

	return getObjectPosition(coin) ~= nil
end

local function getCoins()
	local result = {}

	for _, coin in ipairs(CollectionService:GetTagged("CoinVisual")) do
		if isAvailableCoin(coin) then
			table.insert(result, coin)
		end
	end

	if #result == 0 then
		for _, object in ipairs(workspace:GetDescendants()) do
			if (object:IsA("BasePart") or object:IsA("Model"))
				and contains(object.Name, "coin")
				and isAvailableCoin(object)
			then
				table.insert(result, object)
			end
		end
	end

	return result
end

local function findNearestCoin(root)
	local nearest = nil
	local nearestDistance = math.huge

	for _, coin in ipairs(getCoins()) do
		local position = getObjectPosition(coin)

		if position then
			local distance = (root.Position - position).Magnitude

			if distance < nearestDistance then
				nearest = coin
				nearestDistance = distance
			end
		end
	end

	return nearest
end

local function cancelActiveCoinTween()
	if state.activeCoinTween then
		pcall(function()
			state.activeCoinTween:Cancel()
		end)

		state.activeCoinTween = nil
	end
end

local function resetCoinProgress()
	state.collectedCoins = 0
	state.collectedCoinIds = {}
	state.respawningFromCoinLimit = false
end

local function stopFarmAndRespawn()
	if state.respawningFromCoinLimit then
		return
	end

	state.respawningFromCoinLimit = true
	state.autoCoinEnabled = false
	state.waitingForNextRound = true
	cancelActiveCoinTween()

	local character = LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")

	if humanoid and humanoid.Health > 0 then
		humanoid.Health = 0
	elseif character then
		character:BreakJoints()
	end
end

local function registerCollectedCoin(coinId)
	if not state.autoCoinEnabled
		or not state.roundActive
		or state.waitingForNextRound
	then
		return
	end

	local key = tostring(coinId or ("coin_" .. tostring(os.clock())))

	if state.collectedCoinIds[key] then
		return
	end

	state.collectedCoinIds[key] = true
	state.collectedCoins += 1

	if state.collectedCoins >= state.coinLimit then
		stopFarmAndRespawn()
	end
end

local function connectCoinEvents()
	local gameplayCoinCollected =
		gameplayRemotes
		and gameplayRemotes:FindFirstChild("CoinCollected")

	if gameplayCoinCollected and gameplayCoinCollected:IsA("RemoteEvent") then
		connect(gameplayCoinCollected.OnClientEvent, function(coinId, currentAmount, requiredAmount)
			if currentAmount == nil
				or requiredAmount == nil
				or tonumber(currentAmount) >= tonumber(requiredAmount)
			then
				registerCollectedCoin(coinId)
			end
		end)
	end

	local insight = ReplicatedStorage:FindFirstChild("Insight")
	local insightCoinCollected = insight and insight:FindFirstChild("CoinCollected")
	local insightRoundPlayed = insight and insight:FindFirstChild("RoundPlayed")

	if insightCoinCollected and insightCoinCollected:IsA("RemoteEvent") then
		connect(insightCoinCollected.OnClientEvent, function(coinId)
			registerCollectedCoin(coinId)
		end)
	end

	if insightRoundPlayed and insightRoundPlayed:IsA("RemoteEvent") then
		connect(insightRoundPlayed.OnClientEvent, function()
			state.waitingForNextRound = true
			state.autoCoinEnabled = false
