local function evaluateRoundEnd()
	if not state.lastRoundActive or state.roundActive then
		state.lastRoundActive = state.roundActive
		return
	end

	local role = state.lastLocalRole
	local survived = state.lastLocalAlive
	local victory =
		survived
		and (
			role == "Innocent"
			or role == "Sheriff"
			or role == "Hero"
			or role == "Murderer"
		)

	setRoundResult(victory and "Victory" or "Round Ended", 3)
	state.lastRoundActive = false
end

