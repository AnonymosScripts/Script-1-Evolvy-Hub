	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			updateESP(player)
		end
	end
end)

Players.PlayerRemoving:Connect(function(player)
	destroyHighlight(player)
	destroyNameTag(player)
	state.lastRoles[player] = nil
end)

connect(RunService.Heartbeat, function(deltaTime)
	state.roleColorTime += deltaTime
end)

task.spawn(function()
	while not state.destroyed do
		local wasActive = state.roundActive
		refreshRoundState()
		updateOriginalSheriff()

		if state.roundActive then
			state.lastRoundActive = true
			updateLocalRoundSnapshot()

			if state.waitingForNextRound and isLocalPlayerAlive() then
				state.waitingForNextRound = false
				resetCoinProgress()
				state.lastCoinRecoveryTeleport = os.clock()
			end
		elseif wasActive or state.lastRoundActive then
			evaluateRoundEnd()
			state.waitingForNextRound = true
			cancelActiveCoinTween()
		end

		for _, player in ipairs(Players:GetPlayers()) do
			updateESP(player)
		end

		task.wait(CONFIG.ROLE_UPDATE_INTERVAL)
	end
end)

task.spawn(function()
	while not state.destroyed do
		if state.roundActive then
			if state.autoTP.DroppedGun then
				teleportToDroppedGun()
			end

			if state.autoTP.Murderer then
				teleportToRole({ Murderer = true })
			end

			if state.autoTP.Sheriff then
				teleportToCurrentSheriffOrGun()
			end

			if state.autoTP.Innocent then
				teleportToRole({ Innocent = true })
			end
		end

		task.wait(state.autoTPInterval)
	end
end)

task.spawn(function()
	while not state.destroyed do
		farmCoin()

		if state.autoCoinEnabled
			and state.roundActive
			and not state.waitingForNextRound
			and isLocalPlayerAlive()
			and os.clock() - state.lastCoinRecoveryTeleport >= state.coinRecoveryInterval
		then
			state.lastCoinRecoveryTeleport = os.clock()

			local success = teleportToRole({ Innocent = true })

			if not success then
				-- Retry later instead of repeatedly teleporting every frame.
				state.lastCoinRecoveryTeleport =
					os.clock() - state.coinRecoveryInterval + 3
			end
		end

		task.wait(CONFIG.COIN_INTERVAL)
	end
end)

script.Destroying:Connect(function()
	state.destroyed = true
	cancelActiveCoinTween()
	setAntiAfkEnabled(false)


	for _, connection in ipairs(state.connections) do
		connection:Disconnect()
	end

	for player in pairs(state.highlights) do
		destroyHighlight(player)
	end


	if gui then
		gui:Destroy()
	end
end)
