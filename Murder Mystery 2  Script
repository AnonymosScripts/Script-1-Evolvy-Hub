local function getPlayerDataTable()
	if CurrentRoundClient and type(CurrentRoundClient.PlayerData) == "table" then
		return CurrentRoundClient.PlayerData
	end

	return {}
end

local function getRoundInfoForPlayer(player)
	local data = getPlayerDataTable()

	local direct =
		data[player.Name]
		or data[player.UserId]
		or data[tostring(player.UserId)]

	if type(direct) == "table" then
		return direct
	end

	for key, value in pairs(data) do
		if type(value) == "table" then
			local playerName =
				value.PlayerName
				or value.Name
				or value.Username

			local userId =
				tonumber(value.UserId)
				or tonumber(value.PlayerId)

			if playerName == player.Name
				or userId == player.UserId
				or key == player.Name
				or tonumber(key) == player.UserId
			then
				return value
			end
		end
	end

	return nil
end

local function isPlayerInActiveRound(player)
	if not state.roundActive then
		return false
	end

	local info = getRoundInfoForPlayer(player)

	if type(info) ~= "table" then
		return false
	end

	if info.Alive == false
		or info.IsAlive == false
		or info.Dead == true
		or info.Eliminated == true
	then
		return false
	end

	return info.Role ~= nil
end

local function hasValidRoundData()
	local data = getPlayerDataTable()

	if next(data) == nil then
		return false
	end

	for _, info in pairs(data) do
		if type(info) == "table" and info.Role then
			return true
		end
	end

	return false
end

local function refreshRoundState()
	state.roundActive = hasValidRoundData()
end

if CurrentRoundClient and CurrentRoundClient.PlayerDataChanged then
