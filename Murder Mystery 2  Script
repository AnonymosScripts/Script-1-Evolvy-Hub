local function moveSmoothlyBelowCoin(character, root, coinPosition)
	cancelActiveCoinTween()

	local targetPosition = coinPosition + Vector3.new(0, 0.6, 0)
	local distance = (root.Position - targetPosition).Magnitude
	local duration = math.clamp(
		distance / CONFIG.COIN_MOVE_SPEED,
		CONFIG.COIN_MIN_MOVE_TIME,
		CONFIG.COIN_MAX_MOVE_TIME
	)

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero

	local tween = TweenService:Create(
		root,
		TweenInfo.new(
			duration,
			Enum.EasingStyle.Linear,
			Enum.EasingDirection.Out
		),
		{
			CFrame = CFrame.new(targetPosition)
		}
	)

	state.activeCoinTween = tween
	tween:Play()

	local completedState = tween.Completed:Wait()

	if state.activeCoinTween == tween then
		state.activeCoinTween = nil
	end

	return completedState == Enum.PlaybackState.Completed
end

local function farmCoin()
	if not state.autoCoinEnabled
		or not state.roundActive
		or state.waitingForNextRound
	then
		cancelActiveCoinTween()
		return
	end

	local character, humanoid, root = getLocalCharacter()

	if not character or not humanoid or not root then
		cancelActiveCoinTween()
		return
	end

	local coin = findNearestCoin(root)

	if not coin then
		cancelActiveCoinTween()
		return
	end

	local position = getObjectPosition(coin)

	if not position then
		return
	end

	local arrived = moveSmoothlyBelowCoin(character, root, position)

	if arrived
		and state.autoCoinEnabled
		and state.roundActive
		and not state.waitingForNextRound
	then
		-- Permanece um pouco na moeda para dar tempo de coletar
		-- antes de procurar e seguir para a próxima.
		task.wait(CONFIG.COIN_WAIT_AFTER_ARRIVAL)
	end
end

local function isInsideIgnoredDisplay(object)
	local current = object

	while current and current ~= workspace do
		if current.Name == "WeaponDisplays"
			or current.Name == "GunDisplay"
			or current.Name == "KnifeDisplay"
		then
			return true
		end

		current = current.Parent
	end

	return false
end

local function belongsToPlayer(object)
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local backpack = player:FindFirstChildOfClass("Backpack")

		if character and object:IsDescendantOf(character) then
			return true
		end

		if backpack and object:IsDescendantOf(backpack) then
			return true
		end
	end

	return false
end

local function findGunRoot(object)
	if object:IsA("BasePart") then
		return object
	end

	if object:IsA("Tool") or object:IsA("Model") then
		local root = object:FindFirstChild("HumanoidRootPart", true)
			or object:FindFirstChild("Handle", true)
			or object.PrimaryPart
			or object:FindFirstChildWhichIsA("MeshPart", true)
			or object:FindFirstChildWhichIsA("BasePart", true)

		if root and root:IsA("BasePart") then
			return root
		end
	end

	return nil
end

local function hasGunAttachments(root)
	-- Mantido por compatibilidade, mas não é mais obrigatório.
	return root ~= nil
end

local function isExactGunDrop(object)
	if not object or not object:IsA("BasePart") then
		return false
	end

	if object.Name ~= "GunDrop" then
		return false
	end

	if not object:IsDescendantOf(workspace) then
		return false
	end

	if isInsideIgnoredDisplay(object) or belongsToPlayer(object) then
		return false
	end

	-- Exact structure observed in the game:
	-- GunDrop [Part]
	--   Fire [Fire]
	--   Mesh [SpecialMesh]
	--   TouchInterest [TouchTransmitter]
	local hasFire = object:FindFirstChildOfClass("Fire") ~= nil
	local hasMesh = object:FindFirstChildOfClass("SpecialMesh") ~= nil
	local hasTouch =
		object:FindFirstChild("TouchInterest") ~= nil
		or object:FindFirstChildOfClass("TouchTransmitter") ~= nil

	return hasFire and hasMesh and hasTouch
end

local function findGunRoot(object)
	if isExactGunDrop(object) then
		return object
	end

	return nil
end

local function isDroppedSheriffGun(object)
	return isExactGunDrop(object)
end

local function scanDroppedGun()
	local nearestObject = nil
	local nearestDistance = math.huge
	local viewerPosition = getViewerPosition()

	for _, object in ipairs(workspace:GetDescendants()) do
		if isExactGunDrop(object) then
			local distance = (viewerPosition - object.Position).Magnitude

			if distance < nearestDistance then
				nearestObject = object
				nearestDistance = distance
			end
		end
	end

	state.droppedGunCandidate = nearestObject
	state.droppedGunRoot = nearestObject
	state.lastDroppedGunScan = os.clock()

	return nearestObject, nearestObject
end

local function findNearestDroppedGun(_)
	local cachedObject = state.droppedGunCandidate
	local cachedRoot = state.droppedGunRoot

	if cachedObject
		and cachedObject.Parent
		and cachedRoot
		and cachedRoot.Parent
		and isExactGunDrop(cachedObject)
	then
		return cachedObject, cachedRoot
	end

	if os.clock() - state.lastDroppedGunScan < state.droppedGunScanInterval then
		return nil, nil
	end

	return scanDroppedGun()
end

local function moveLocalCharacter(targetCFrame)
	local character, humanoid, root = getLocalCharacter()

	if not character or not humanoid or not root then
		return false
	end

	for _ = 1, 3 do
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
		character:PivotTo(targetCFrame)
		root.CFrame = targetCFrame
		task.wait(0.08)
	end

	return (root.Position - targetCFrame.Position).Magnitude <= 12
end

local function teleportToDroppedGun()
	if not state.roundActive then
		return false, "No active match"
	end

	local currentHolder = getCurrentGunHolder()

	if currentHolder then
		return false, "Gun is currently held by " .. currentHolder.Name
	end

	local character, _, root = getLocalCharacter()

	if not character or not root then
		return false, "Character unavailable"
	end

	local gun, gunRoot = findNearestDroppedGun(root)

	if not gun or not gunRoot then
		gun, gunRoot = scanDroppedGun()
	end

	if not gun or not gunRoot then
		return false, "Dropped Sheriff gun not found"
	end

	local targetCFrame =
		CFrame.new(gunRoot.Position + Vector3.new(0, 2.2, 0))

	local moved = moveLocalCharacter(targetCFrame)

	if not moved then
		return false, "Teleport was blocked"
	end

	log("Teleported to dropped gun:", gun:GetFullName())
	return true, "Teleported to dropped Gun"
end

local function teleportToCurrentSheriffOrGun()
	if not state.roundActive then
		return false, "No active match"
	end

	local holder, _, holderRole = getCurrentGunHolder()

	if holder then
		if holder == LocalPlayer then
			return true, "You are holding the Gun"
		end

		local _, humanoid, root = getCharacterData(holder)

		if humanoid and humanoid.Health > 0 and root then
			local moved = moveLocalCharacter(root.CFrame * CFrame.new(0, 0, 4))

			if moved then
				return true, "Teleported to current " .. holderRole
			end

			return false, "Teleport was blocked"
		end
	end

	return teleportToDroppedGun()
end

local function teleportToRole(roleNames)
	if not state.roundActive then
		return false, "No active match"
	end

	local target = getRolePlayer(roleNames)

	if not target then
		return false, "Target not found"
	end

	local character, _, _ = getLocalCharacter()
	local _, targetHumanoid, targetRoot = getCharacterData(target)

	if not character or not targetHumanoid or targetHumanoid.Health <= 0 or not targetRoot then
		return false, "Target unavailable"
	end

	character:PivotTo(
		targetRoot.CFrame * CFrame.new(0, 0, 4)
	)

	return true
end

