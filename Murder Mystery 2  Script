local function matchesWeaponName(name, accepted)
	local normalized = lower(name)

	if accepted[normalized] then
		return true
	end

	for acceptedName in pairs(accepted) do
		if string.find(normalized, acceptedName, 1, true) then
			return true
		end
	end

	return false
end

local function findWeapon(container, accepted)
	if not container then
		return nil
	end

	for _, object in ipairs(container:GetDescendants()) do
		if object:IsA("Tool") and matchesWeaponName(object.Name, accepted) then
			return object
		end
	end

	return nil
end

local function getRoleFromRoundData(player)
	local data = getPlayerDataTable()

	local info =
		data[player.Name]
		or data[player.UserId]
		or data[tostring(player.UserId)]

	if type(info) == "table" and info.Role then
		return tostring(info.Role)
	end

	for key, value in pairs(data) do
		if type(value) == "table" then
			local playerName = value.PlayerName or value.Name or value.Username
			local userId = value.UserId or value.PlayerId

			if playerName == player.Name or tonumber(userId) == player.UserId then
				if value.Role then
					return tostring(value.Role)
				end
			end
		elseif key == player.Name and type(value) == "string" then
			return value
		end
	end

	return nil
end

local function normalizeRole(role)
	local normalized = lower(role)

	if contains(normalized, "murder") or contains(normalized, "assassin") then
		return "Murderer"
	end

	if contains(normalized, "sheriff") then
		return "Sheriff"
	end

	if contains(normalized, "hero") then
		return "Hero"
	end

	if contains(normalized, "innocent") then
		return "Innocent"
	end

	return nil
end

local function findOriginalSheriffFromRoundData()
	local data = getPlayerDataTable()

	for key, value in pairs(data) do
		if type(value) == "table" then
			local normalizedRole = normalizeRole(value.Role)

			if normalizedRole == "Sheriff" then
				local userId =
					tonumber(value.UserId)
					or tonumber(value.PlayerId)

				if userId then
					return userId
				end

				local playerName =
					value.PlayerName
					or value.Name
					or value.Username
					or (type(key) == "string" and key or nil)

				if playerName then
					local player = Players:FindFirstChild(playerName)

					if player then
						return player.UserId
					end
				end
			end
		elseif type(value) == "string" and normalizeRole(value) == "Sheriff" then
			if type(key) == "string" then
				local player = Players:FindFirstChild(key)

				if player then
					return player.UserId
				end
			end
		end
	end

	return nil
end

local function updateOriginalSheriff()
	if not state.roundActive then
		state.originalSheriffUserId = nil
		state.wasRoundActive = false
		return
	end

	if not state.wasRoundActive then
		state.wasRoundActive = true
		state.originalSheriffUserId = findOriginalSheriffFromRoundData()
	end

	if state.originalSheriffUserId then
		return
	end

	local fromData = findOriginalSheriffFromRoundData()

	if fromData then
		state.originalSheriffUserId = fromData
		return
	end

	-- Fallback only at the beginning of the match:
	-- whoever first holds the Gun is treated as the original Sheriff.
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local backpack = player:FindFirstChildOfClass("Backpack")

		local gun =
			findWeapon(character, CONFIG.GUN_NAMES)
			or findWeapon(backpack, CONFIG.GUN_NAMES)

		if gun then
			state.originalSheriffUserId = player.UserId
			return
		end
	end
end

local function detectRole(player)
	if not state.roundActive then
		return "Lobby", "No active match"
	end

	local character = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")

	local knife =
		findWeapon(character, CONFIG.KNIFE_NAMES)
		or findWeapon(backpack, CONFIG.KNIFE_NAMES)

	if knife then
		return "Murderer", knife:GetFullName()
	end

	local gun =
		findWeapon(character, CONFIG.GUN_NAMES)
		or findWeapon(backpack, CONFIG.GUN_NAMES)

	if gun then
		local moduleRole = getRoleFromRoundData(player)
		local normalizedRole = moduleRole and normalizeRole(moduleRole)

		if state.originalSheriffUserId == player.UserId then
			return "Sheriff", gun:GetFullName()
		end

		return "Hero", gun:GetFullName()
	end

	local moduleRole = getRoleFromRoundData(player)
	local normalizedRole = moduleRole and normalizeRole(moduleRole)

	if normalizedRole == "Murderer" then
		return "Murderer", "CurrentRoundClient"
	end

	if normalizedRole == "Sheriff" or normalizedRole == "Hero" then
		return "Innocent", "Not holding Gun"
	end

	if normalizedRole == "Innocent" then
		return "Innocent", "CurrentRoundClient"
	end

	return "Innocent", "No Knife or Gun"
end

local function getCurrentGunHolder()
	for _, player in ipairs(Players:GetPlayers()) do
		local character, humanoid, root = getCharacterData(player)
		local backpack = player:FindFirstChildOfClass("Backpack")

		if character and humanoid and humanoid.Health > 0 and root then
			local gun =
				findWeapon(character, CONFIG.GUN_NAMES)
				or findWeapon(backpack, CONFIG.GUN_NAMES)

			if gun then
				local role =
					state.originalSheriffUserId == player.UserId
					and "Sheriff"
					or "Hero"

				return player, gun, role
			end
		end
	end

	return nil, nil, nil
end

local function getRolePlayer(roleNames)
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and isPlayerInActiveRound(player) then
			local role = detectRole(player)

			if roleNames[role] then
				local character, humanoid, root = getCharacterData(player)

				if character and humanoid and humanoid.Health > 0 and root then
					return player
				end
			end
		end
	end

	return nil
end

